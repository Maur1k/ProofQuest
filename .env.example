# Server-only. Never prefix credentials with VITE_.
GROQ_API_KEY=
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
# Generate a random secret of at least 32 characters; share across active hosts.
PROOFQUEST_GUEST_SECRET=
PROOFQUEST_GENERATION_ENABLED=false
# Exact origin, no trailing slash. Configure separately for each host.
PROOFQUEST_ORIGIN=http://127.0.0.1:4191

# Comma-separated formats only AFTER host quality acceptance: quiz,reviewer,flashcards
# Empty denies every format even when the global switch is true.
PROOFQUEST_APPROVED_FORMATS=
